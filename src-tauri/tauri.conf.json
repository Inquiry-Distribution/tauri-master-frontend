{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "inquiryHub",
  "version": "0.1.0",
  "identifier": "com.inquiryHub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false 
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNDk1NzJFOTVCOTlDNkQKUldSdG5MbVZMbGRKODBqZmtBTUl0MjIrV0ZFVEg2bkxqRVViSTZzcW9tRG9YOXRVLzFoMlhqbTMK",
      "endpoints": [
        "https://github.com/Inquiry-Distribution/tauri-master-frontend/releases/latest/download/latest.json"
      ]
    }
  },

  "app": {
    "windows": [
      {
        "title": "Inquiry Management System",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
