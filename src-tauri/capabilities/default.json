{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read",
    "fs:scope-app",
    "fs:scope-download",
    "fs:scope-desktop",

    "shell:allow-open",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "fs:allow-write-file",
    "fs:allow-app-write",
    "fs:allow-home-write",
    "fs:allow-download-write",
    "fs:scope-download-recursive",
    "fs:scope-home-recursive"
  ],
  "csp": "default-src 'self' data: blob: filesystem: ws: http://localhost:* https://*.tile.openstreetmap.org;"
}
